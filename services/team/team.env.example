# app-ads-team — runtime config for the team-facing ad view + /api/team/* reverse proxy.
# Copy to team.env on the VM and fill in. All values are CONFIG, not secrets (this
# container holds ZERO credentials — DESIGN.md §3 inv 2). Injected at container start.
#
# DEPLOY NOTE: this origin (team-ads.gpsaswimming.org) MUST sit behind the edge's email
# auth. The edge authenticates the viewer and injects the verified identity header,
# STRIPPING any client-supplied copy, before proxying here. Without that gate the view is
# open. The header name the edge injects must match the Ads API's TEAM_IDENTITY_HEADER
# (default X-Forwarded-Email).

# Ads API upstream (host:port) that nginx reverse-proxies /api/team/* to. Cleartext HTTP
# between tiers by design; resolved lazily so the page still serves if the API is briefly down.
API_UPSTREAM=ads-api:8080

# Public submission form the "fix & resubmit" link (on rejected ads) points to.
ADS_FORM_URL=https://ads.gpsaswimming.org/

# DNS resolver nginx uses to look up API_UPSTREAM. Default 127.0.0.11 is Docker's embedded
# DNS (correct for the compose deployment). On a bare VM using system DNS, set this to that
# resolver (e.g. 127.0.0.53 for systemd-resolved, or your LAN DNS).
# RESOLVER=127.0.0.11
